# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID, from the same Developer Portal page
CLIENT_ID=

# Optional: set this during development to register slash commands
# instantly to one or more servers instead of waiting up to an hour for global sync
# (comma-separated for multiple guilds)
GUILD_ID=

# Channel ID where the daily summary should be posted
CHANNEL_ID=

# Chrono Genesis API
CHRONO_API_KEY=
CIRCLE_ID=

# Display name for the club, and the key its settings are stored under in data/config.json
CLUB_NAME=
CLUB_KEY=

# Optional second club, same fields as above. Its card colors use CLUB_2_COLOR_* in place
# of MEMBERS_COLOR_*.
CIRCLE_ID_2=
CLUB_NAME_2=
CLUB_KEY_2=

# Hour of day (UTC, 0-23) to post the daily summary
POST_HOUR_UTC=9

# Required daily fan gain per member, used by /members for the quota/buffer stats
QUOTA_PER_DAY=600000

# uma.moe API key (Settings > API Keys on uma.moe, requires a uma.moe account),
# used by /share_parent to look up a trainer profile by UID
UMA_MOE_API_KEY=

# Discord user ID to DM a best-effort warning to on graceful shutdown or an
# uncaught crash (SIGINT/SIGTERM/uncaughtException/unhandledRejection only —
# a kill -9, OOM kill, or host crash gives no chance to send this). Optional;
# leave blank to disable.
ADMIN_USER_ID=

# --- /members color scheme ---
# Hex colors ("#rrggbb", keep the quotes) for the /members card. Leave any blank to use
# the built-in default shown. Restart the bot after changing these.
MEMBERS_COLOR_BG="#f1d7d6"         # page background
MEMBERS_COLOR_SECTION="#f1d7d6"    # inside of the card boxes
MEMBERS_COLOR_BORDER="#950001"     # box borders
MEMBERS_COLOR_TEXT="#000000"       # main text (names, numbers)
MEMBERS_COLOR_SUBTEXT="#950001"    # labels, column headers, footer
MEMBERS_COLOR_RED="#e0002a"        # bottom 2 rows, quota line, negative buffer/rank
MEMBERS_COLOR_YELLOW="#b7791f"     # rows 3-4 from the bottom, goal line, goal stats
MEMBERS_COLOR_GREEN="#1e7b34"      # positive buffer, rank improvement
