DISCORD_BOT_TOKEN=your-bot-token-here
# Optional: restrict command sync to one guild during development for instant propagation
DEV_GUILD_ID=123456789012345678
# Optional, testing only: let /registration add sign the bot itself up, and have it ready up for its matches
# BOT_PLAYS_FOR_TESTING=1
# Optional: custom emojis from the server, by name, to use in place of the standard ones in posts.
# The bot must be in a server that has them (or they can be application emojis); without one,
# the standard emoji shown beside each setting is used.
# BOT_EMOJI=your_bot_emoji          # 🎫 sign-ups, 5v5 event post and predictions opening
# ROOM_EMOJI=your_room_emoji        # 🎟️ a 5v5 room being ready, and its room code
# RESULTS_EMOJI=your_results_emoji  # 📸 a 5v5 lobby's results post
# MISMATCH_EMOJI=your_mismatch_emoji  # 🔍 5v5 points that don't match
